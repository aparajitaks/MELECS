# ============================================================
# MELECS MAILER – SMTP CONFIGURATION
# ============================================================
# Rename this file to .env and fill in your real values.
# NEVER commit .env to version control.

# Gmail address used to SEND emails (must be the account that owns the App Password)
SMTP_USER=your-gmail@gmail.com

# Gmail App Password (16 chars, no spaces)
# How to generate: Google Account → Security → 2-Step Verification → App Passwords
# Generate one for "Mail" / "Other (Custom name: Melecs Mailer)"
SMTP_PASS=your-16-char-app-password

# Where to DELIVER inquiry emails
MAIL_TO=careers@melecstech.com

# (Optional) Reply-To override – leave blank to use sender's email
MAIL_REPLY_TO=

# Port for the Node.js mailer server (keep 3001 unless it conflicts)
PORT=3001

